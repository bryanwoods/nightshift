# Curfew's lullaby: the waltz from the main theme, moved to C.
# Its hook is E, G, C: high, low, middle. Those are the pitches of the falling notes in
# Curfew's first attack, and the answer you hum back to put Curfew to bed.
tempo 88
meter 3/4
grid 6
key C major
form Cradle A B A2 Tag

voice box   inst=bell vol=0.46 ring=1.5 decay=2 role=melody pan=-0.08 rev=0.34 shape=0.08 human=0.004
voice oca   inst=flute vol=0.30 vib=12 att=0.04 rel=0.16 role=melody pan=0.18 rev=0.36 shape=0.1 human=0.005
voice bell  inst=bell vol=0.12 ring=1.0 decay=3 pan=0.3 rev=0.4
voice bass  inst=bass vol=0.62 gate=0.84 pluck=11 dec=0.3 sus=0.5 role=bass human=0.004
voice waltz inst=epiano auto=comp pattern=--x.x. lo=55 hi=72 size=3 vol=0.22 pan=0.2 rev=0.3 human=0.004
voice pad   inst=pad auto=chords lo=50 hi=72 vol=0.13 tone=1000 att=0.5 rev=0.48
voice kit   inst=drums vol=0.13 human=0.003

master room=2.5 wet=0.5 loud=-18

