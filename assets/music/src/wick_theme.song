voice oca   inst=flute vol=0.36 vib=15 pan=0.06 rev=0.4 role=melody shape=0.12 human=0.004
voice vibes inst=vibes vol=0.42 trem=0.4 rate=5.0 pan=-0.12 rev=0.45 role=melody human=0.004
voice vibarp inst=vibes auto=arp:up lo=57 hi=79 vol=0.16 trem=0.3 rate=5.0 gate=0.9 pan=0.3 rev=0.45
voice picc  inst=flute vol=0.20 vib=20 pan=0.22 rev=0.4 role=melody shape=0.1 human=0.003
voice bgtr  inst=guitar drive=4 tone=1500 mid=600 hp=35 dec=0.5 sus=0.6 vib=0 scoop=0 rel=0.08 gate=0.9 vol=0.30 pan=-0.3 human=0.004
voice bell  inst=bell vol=0.10 ring=0.8 pan=0.26 rev=0.3
voice bass  inst=bass vol=0.70 gate=0.6 pluck=18 dec=0.14 sus=0.4 role=bass human=0.002
voice arp   inst=pulse duty=0.125 auto=arp:updown lo=62 hi=86 vol=0.06 pan=0.44 tone=3000 rel=0.04 gate=0.5 echo=0.2 echotime=0.5
voice pad   inst=pad auto=chords lo=50 hi=72 vol=0.12 tone=1000 rev=0.45 att=0.4
voice keys  inst=epiano auto=comp pattern=x..x..x. lo=57 hi=74 size=3 vol=0.08 pan=0.2 rev=0.2 gate=0.6
voice kit   inst=drums vol=0.34

master room=1.6 wet=0.38 loud=-18

