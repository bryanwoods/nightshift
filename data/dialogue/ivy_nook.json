        },
        {
          "text": "You take the cloud pajamas off the rack and change behind the hedge."
        },
        {
          "text": "Nobody says anything.",
          "dark": true
        }
      ]
    },
    "nook_favor": {
      "lines": [
        {
          "speaker": "no_job",
          "text": "Do I need anything?"
        },
        {
          "speaker": "no_job",
          "text": "Everyone at the Depot has a timecard."
        },
        {
          "speaker": "no_job",
          "text": "Is there one for me?"
        },
        {
          "cmd": "set_flag",
          "flag": "nook_quest"
        },
        {
          "text": "No Job wants a blank timecard from the Depot."
        }
      ]
    },
    "nook_favor_done": {
      "lines": [
        {
          "cmd": "take_item",
          "item": "blank_timecard"
        },
        {
          "cmd": "set_flag",
          "flag": "nook_quest_done"
        },
        {
          "speaker": "no_job",
          "text": "Is this mine?"
        },
        {
          "text": "No Job writes on it with one long finger: NO JOB."
        },
        {
          "speaker": "no_job",
          "text": "Now I am on the list."
        },
        {
          "speaker": "no_job",
          "text": "Take this. It is warm."
        },
        {
          "cmd": "give_item",
          "item": "mug_of_cocoa"
        },
        {
          "cmd": "sfx",
          "name": "chime"
        },
        {
          "text": "You got a mug of cocoa! In a fight, it gives +12 Awake."
        }
      ]
    },
    "nook_wear_midnight": {
      "lines": [
        {
          "cmd": "wear",
          "outfit": "midnight"
        },
        {
          "cmd": "sfx",
          "name": "rustle"
        },
        {
          "text": "You change into the midnight pajamas behind the hedge."
        }
      ]
    },
    "nook_mirror": {
      "lines": [
        {
          "text": "A tall mirror. Tadzio looks back, in plain clothes.",
          "unless_flag": [
            "wearing_star",
            "wearing_frog",
            "wearing_moon",
            "wearing_cloud",
            "wearing_midnight"
          ]
        },
        {
          "text": "A tall mirror. Tadzio looks back, covered in tiny gold stars.",
          "if_flag": "wearing_star"
        },
        {
          "text": "A tall mirror. A very green Tadzio looks back. Ribbit.",
          "if_flag": "wearing_frog"
        },
        {
          "text": "A tall mirror. The moon on your pajamas winks at you.",
          "if_flag": "wearing_moon"
        },
        {
          "text": "A tall mirror. Tadzio looks back, fluffy as a cloud.",
          "if_flag": "wearing_cloud"
        },
        {
          "text": "A tall mirror. In it, every tiny clock on your pajamas says 2:00.",
          "if_flag": "wearing_midnight"
        }
      ]
    },
    "nook_cat": {
      "seen_variant": "nook_cat_2",
      "lines": [
        {
          "text": "A cat is asleep on a folded pair of purple pajamas."
        },
        {
          "speaker": "no_job",
          "text": "Is the cat for sale?",
          "unless_gone": "no_job"
        },
        {
          "speaker": "no_job",
          "text": "No.",
          "unless_gone": "no_job"
        }
      ]
    },
    "nook_cat_2": {
      "lines": [
        {
          "text": "The cat is still asleep. One ear twitches when you get close."
        }
      ]
    },
    "nook_stack": {
      "lines": [
        {
          "text": "Pajamas, folded into perfect little squares. Who folds this well?"
        }
      ]
    }
  }
}
