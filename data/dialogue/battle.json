{
  "id": "battle",
  "dialogues": {
    "battle_stall": {
      "lines": [
        {
          "text": "You stall. Hits do half this round."
        }
      ]
    },
    "battle_hustle_miss": {
      "lines": [
        {
          "text": "You fumble it. They barely notice."
        }
      ]
    },
    "battle_pockets_empty": {
      "lines": [ { "text": "Your pockets are empty." } ]
    },
    "battle_finished": {
      "todo": "TODO(Tadzio): what Wick says the first time a worker is gone, and when many are gone.",
      "lines": [
        { "text": "It's quiet now.", "unless_flag": "many_gone" },
        { "text": "Even quieter now.", "dark": true, "if_flag": "many_gone" },
        { "speaker": "wick", "portrait": "wick_sad", "text": "T-Tadzio... everyone heard that. They're hiding. From us.", "if_flag": ["wick_joined", "many_gone"], "unless_flag": "wick_saw_many" },
        { "cmd": "set_flag", "flag": "wick_saw_many", "if_flag": ["wick_joined", "many_gone"] },
        { "cmd": "if_flag", "flag": "wick_saw_gone", "goto": "" },
        { "speaker": "wick", "portrait": "wick_sad", "text": "...", "if_flag": "wick_joined" },
        { "speaker": "wick", "portrait": "wick_sad", "text": "They're gone. They're not coming back. Are they.", "if_flag": "wick_joined" },
        { "cmd": "set_flag", "flag": "wick_saw_gone", "if_flag": "wick_joined" }
      ]
    },
    "battle_asleep": {
      "lines": [
        {
          "text": "Your eyes are so heavy..."
        },
        {
          "text": "Tadzio falls asleep on the spot."
        }
      ]
    }
  }
}